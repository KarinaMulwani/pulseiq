# PulseIQ — Environment Configuration Variables

# -------------------------------------------------------------
# 1. NVIDIA NIM API Configuration (OpenAI-compatible)
# -------------------------------------------------------------
# Obtain your free developer API key from https://build.nvidia.com
# Format: nvapi-...
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: Default Primary Model override
NVIDIA_PRIMARY_MODEL=meta/llama-3.3-70b-instruct

# -------------------------------------------------------------
# 2. Supabase PostgreSQL Configuration (Optional for Cloud Persistence)
# -------------------------------------------------------------
# If omitted, PulseIQ automatically operates in persistent in-browser LocalStorage mode.
# When provided, data syncs to your Supabase PostgreSQL instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -------------------------------------------------------------
# 3. Application Settings
# -------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=PulseIQ
